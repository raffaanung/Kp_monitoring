RewriteEngine On
RewriteBase /edm_task/backend/

# Framework folders stay off the web. The front controller is index.php.
RewriteRule ^(app|vendor|writable|tests|builds)(/|$) - [F,L]
RewriteRule ^(composer\.(json|lock)|spark|preload\.php|phpunit\.dist\.xml|env|README\.md|LICENSE|\.env)$ - [F,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [L,R=301]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([\s\S]*)$ index.php/$1 [L,NC,QSA]
